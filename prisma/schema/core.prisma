model Organization {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  logoUrl         String?
  brandColor      String?
  gstNumber       String?
  panNumber       String?
  currency        String   @default("INR")
  timezone        String   @default("Asia/Kolkata")
  invoicePrefix   String   @default("INV")
  quotationPrefix String   @default("QUO")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users                 User[]
  departments           Department[]
  teams                 Team[]
  leads                 Lead[]
  opportunities         Opportunity[]
  clients               Client[]
  serviceCategories     ServiceCategory[]
  services              Service[]
  quotations            Quotation[]
  contracts             Contract[]
  serviceOrders         ServiceOrder[]
  projects              Project[]
  vendors               Vendor[]
  invoices              Invoice[]
  payments              Payment[]
  creditNotes           CreditNote[]
  debitNotes            DebitNote[]
  tickets               Ticket[]
  appointments          Appointment[]
  notifications         Notification[]
  notificationTemplates NotificationTemplate[]
  documents             Document[]
  renewals              Renewal[]
  automationRules       AutomationRule[]
  auditLogs             AuditLog[]
  activities            Activity[]
  communications        Communication[]
  subscription          Subscription?
  roles                 Role[]
  tasks                 Task[]

  @@map("organizations")
}

model Plan {
  id           String   @id @default(cuid())
  tier         PlanTier @unique
  name         String
  priceMonthly Decimal  @db.Decimal(12, 2)
  priceAnnual  Decimal  @db.Decimal(12, 2)
  maxUsers     Int
  maxClients   Int
  features     Json
  createdAt    DateTime @default(now())

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id             String             @id @default(cuid())
  organizationId String             @unique
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId         String
  plan           Plan               @relation(fields: [planId], references: [id])
  status         SubscriptionStatus @default(TRIALING)
  billingCycle   BillingCycle       @default(MONTHLY)
  startDate      DateTime           @default(now())
  renewalDate    DateTime?
  trialEndsAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@map("subscriptions")
}

model Department {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  createdAt      DateTime     @default(now())

  users Employee[]
  teams Team[]

  @@index([organizationId])
  @@map("departments")
}

model Team {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id])
  name           String
  createdAt      DateTime     @default(now())

  members TeamMember[]

  @@index([organizationId])
  @@map("teams")
}

model TeamMember {
  id     String @id @default(cuid())
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

model Role {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  systemRole     SystemRole?
  isSystem       Boolean       @default(false)
  createdAt      DateTime      @default(now())

  permissions RolePermission[]
  users       UserRole[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

model RolePermission {
  id         String     @id @default(cuid())
  roleId     String
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  resource   String
  permission Permission

  @@unique([roleId, resource, permission])
  @@map("role_permissions")
}

model User {
  id                  String        @id @default(cuid())
  organizationId      String?
  organization        Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email               String
  passwordHash        String?
  name                String
  phone               String?
  avatarUrl           String?
  status              UserStatus    @default(PENDING_VERIFICATION)
  isPlatformAdmin     Boolean       @default(false)
  emailVerifiedAt     DateTime?
  lastLoginAt         DateTime?
  failedLoginAttempts Int           @default(0)
  lockedUntil         DateTime?
  tokenVersion        Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  roles                UserRole[]
  teamMemberships      TeamMember[]
  employeeProfile      Employee?
  vendorProfile        VendorContact?
  clientContactProfile ClientContact?
  passwordResets       PasswordResetToken[]
  emailVerifications   EmailVerificationToken[]
  loginActivities      LoginActivity[]
  sessions             Session[]

  assignedLeads         Lead[]               @relation("LeadAssignee")
  salesOwnedClients     Client[]             @relation("ClientSalesOwner")
  accountManagedClients Client[]             @relation("ClientAccountManager")
  ownedProjects         Project[]            @relation("ProjectManager")
  assignedTasks         Task[]               @relation("TaskAssignee")
  createdTasks          Task[]               @relation("TaskCreatedBy")
  assignedTickets       Ticket[]             @relation("TicketAssignee")
  notifications         Notification[]
  auditLogs             AuditLog[]
  documentsUploaded     Document[]           @relation("DocumentUploadedBy")
  activities            Activity[]           @relation("ActivityUser")
  communications        Communication[]      @relation("CommunicationUser")
  followups             LeadFollowup[]       @relation("FollowupOwner")
  timeEntries           TaskTimeEntry[]
  taskComments          TaskComment[]
  ticketComments        TicketComment[]
  organizedAppointments Appointment[]        @relation("AppointmentOrganizer")
  meetingParticipations MeetingParticipant[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

model Employee {
  id           String      @id @default(cuid())
  userId       String      @unique
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  designation  String?
  employeeCode String?
  createdAt    DateTime    @default(now())

  @@map("employees")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String   @unique
  expires      DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

model LoginActivity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("login_activities")
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  action         String
  entityType     String
  entityId       String
  previousValue  Json?
  newValue       Json?
  ipAddress      String?
  createdAt      DateTime      @default(now())

  @@index([organizationId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Notification {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel        NotificationChannel
  event          String
  title          String
  body           String
  data           Json?
  readAt         DateTime?
  sentAt         DateTime?
  createdAt      DateTime            @default(now())

  @@index([organizationId, userId])
  @@map("notifications")
}

model NotificationTemplate {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event          String
  channel        NotificationChannel
  subject        String?
  body           String
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())

  @@unique([organizationId, event, channel])
  @@map("notification_templates")
}

model Document {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       DocumentCategory
  entityType     String?
  entityId       String?
  name           String
  storageKey     String
  mimeType       String
  sizeBytes      Int
  expiresAt      DateTime?
  uploadedById   String
  uploadedBy     User             @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  createdAt      DateTime         @default(now())

  versions DocumentVersion[]

  @@index([organizationId])
  @@index([entityType, entityId])
  @@map("documents")
}

model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version    Int
  storageKey String
  createdAt  DateTime @default(now())

  @@unique([documentId, version])
  @@map("document_versions")
}

model Activity {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType     String
  entityId       String
  type           ActivityType
  description    String
  userId         String?
  user           User?        @relation("ActivityUser", fields: [userId], references: [id])
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([entityType, entityId])
  @@map("activities")
}

model Communication {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType     String
  entityId       String
  channel        ActivityType
  direction      String
  subject        String?
  content        String?
  userId         String?
  user           User?        @relation("CommunicationUser", fields: [userId], references: [id])
  occurredAt     DateTime     @default(now())

  @@index([organizationId])
  @@index([entityType, entityId])
  @@map("communications")
}

model AutomationRule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  triggerEvent   String
  conditions     Json?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  actions AutomationAction[]

  @@index([organizationId])
  @@map("automation_rules")
}

model AutomationAction {
  id               String         @id @default(cuid())
  automationRuleId String
  automationRule   AutomationRule @relation(fields: [automationRuleId], references: [id], onDelete: Cascade)
  actionType       String
  actionConfig     Json
  order            Int            @default(0)

  @@map("automation_actions")
}
