model Lead {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                String
  company             String?
  email               String?
  phone               String?
  alternatePhone      String?
  website             String?
  industry            String?
  location            String?
  source              String?
  campaign            String?
  requirement         String?
  estimatedValue      Decimal?     @db.Decimal(14, 2)
  assignedToId        String?
  assignedTo          User?        @relation("LeadAssignee", fields: [assignedToId], references: [id])
  priority            LeadPriority @default(MEDIUM)
  status              LeadStatus   @default(NEW)
  expectedClosingDate DateTime?
  tags                String[]     @default([])
  lastContactedAt     DateTime?
  nextFollowupAt      DateTime?
  convertedClientId   String?      @unique
  convertedClient     Client?      @relation("LeadConversion", fields: [convertedClientId], references: [id])
  convertedAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  activities LeadActivity[]
  followups  LeadFollowup[]
  quotations Quotation[]
  notes      LeadNote[]

  @@index([organizationId, status])
  @@index([organizationId, assignedToId])
  @@map("leads")
}

model LeadActivity {
  id        String       @id @default(cuid())
  leadId    String
  lead      Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      ActivityType
  notes     String?
  createdAt DateTime     @default(now())

  @@index([leadId])
  @@map("lead_activities")
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([leadId])
  @@map("lead_notes")
}

model LeadFollowup {
  id          String         @id @default(cuid())
  leadId      String
  lead        Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  ownerId     String
  owner       User           @relation("FollowupOwner", fields: [ownerId], references: [id])
  type        ActivityType
  purpose     String
  scheduledAt DateTime
  status      FollowupStatus @default(PENDING)
  notes       String?
  createdAt   DateTime       @default(now())

  @@index([leadId])
  @@index([ownerId, status])
  @@map("lead_followups")
}

model Opportunity {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId          String?
  client            Client?      @relation(fields: [clientId], references: [id])
  name              String
  value             Decimal      @db.Decimal(14, 2)
  stage             LeadStatus   @default(QUALIFIED)
  expectedCloseDate DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([organizationId])
  @@map("opportunities")
}

model Client {
  id               String         @id @default(cuid())
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  companyName      String?
  category         ClientCategory @default(BUSINESS)
  industry         String?
  gstNumber        String?
  panNumber        String?
  status           ClientStatus   @default(ACTIVE)
  healthScore      Int            @default(100)
  leadSource       String?
  salesOwnerId     String?
  salesOwner       User?          @relation("ClientSalesOwner", fields: [salesOwnerId], references: [id])
  accountManagerId String?
  accountManager   User?          @relation("ClientAccountManager", fields: [accountManagerId], references: [id])
  tags             String[]       @default([])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  originatingLead Lead?                @relation("LeadConversion")
  contacts        ClientContact[]
  addresses       ClientAddress[]
  notes           ClientNote[]
  opportunities   Opportunity[]
  quotations      Quotation[]
  contracts       Contract[]
  serviceOrders   ServiceOrder[]
  projects        Project[]
  invoices        Invoice[]
  payments        Payment[]
  tickets         Ticket[]
  appointments    Appointment[]
  documents       DocumentClientLink[]
  renewals        Renewal[]
  kickoffDocuments KickoffDocument[]
  contentSheets    ContentSheet[]

  @@index([organizationId, status])
  @@map("clients")
}

model KickoffDocument {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId        String
  client          Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title           String
  goals           String?
  scope           String?
  timeline        String?
  targetAudience  String?
  brandGuidelines String?
  keyContacts     String?
  notes           String?
  createdById     String?
  createdBy       User?        @relation(fields: [createdById], references: [id])
  sharedAt        DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId, clientId])
  @@map("kickoff_documents")
}

model ContentSheet {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  month          Int
  year           Int
  createdById    String?
  createdBy      User?    @relation(fields: [createdById], references: [id])
  createdAt      DateTime @default(now())

  items ContentSheetItem[]

  @@unique([clientId, month, year])
  @@index([organizationId, clientId])
  @@map("content_sheets")
}

model ContentSheetItem {
  id             String            @id @default(cuid())
  contentSheetId String
  contentSheet   ContentSheet      @relation(fields: [contentSheetId], references: [id], onDelete: Cascade)
  date           DateTime?
  platform       String?
  contentType    String?
  caption        String?
  status         ContentItemStatus @default(DRAFT)
  notes          String?
  createdById    String?
  createdBy      User?             @relation(fields: [createdById], references: [id])
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([contentSheetId])
  @@map("content_sheet_items")
}

model ClientContact {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId      String?  @unique
  user        User?    @relation(fields: [userId], references: [id])
  name        String
  email       String?
  phone       String?
  designation String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([clientId])
  @@map("client_contacts")
}

model ClientAddress {
  id         String      @id @default(cuid())
  clientId   String
  client     Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type       AddressType
  line1      String
  line2      String?
  city       String?
  state      String?
  country    String?
  postalCode String?

  @@index([clientId])
  @@map("client_addresses")
}

model ClientNote {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  content    String
  isInternal Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([clientId])
  @@map("client_notes")
}

model DocumentClientLink {
  id         String @id @default(cuid())
  clientId   String
  client     Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  documentId String

  @@unique([clientId, documentId])
  @@map("document_client_links")
}
