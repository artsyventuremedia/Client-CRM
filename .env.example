# For a real Postgres instance, the plain connection string is fine.
# For `npx prisma dev` locally, keep connection_limit=1 - see README "Getting started".
DATABASE_URL="postgres://user:password@localhost:5432/clientops?sslmode=disable&connection_limit=1"

# Only needed if your datasource block sets shadowDatabaseUrl (used by `npx prisma dev`
# to run migrations against a separate scratch database). Omit for a real Postgres instance
# where Prisma can create/drop its own shadow database automatically.
# SHADOW_DATABASE_URL="postgres://user:password@localhost:5432/clientops_shadow?sslmode=disable"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_SECRET="same-value-as-AUTH_SECRET"
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
